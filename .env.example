# Copy to .env.local for local development (never commit .env.local).
# On Vercel, add the same names under Project > Settings > Environment Variables.

# Public values (safe for the browser): Supabase > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET: only the server function in /api uses it. Never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
